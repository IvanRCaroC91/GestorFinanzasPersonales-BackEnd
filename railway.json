{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "docker-compose build",
    "watchPatterns": [
      "**/*.java",
      "**/pom.xml",
      "**/application*.yml",
      "**/Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "docker-compose up -d",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/actuator/health"
  },
  "services": {
    "postgres": {
      "serviceType": "postgres",
      "plan": "free"
    },
    "eureka": {
      "serviceType": "web",
      "plan": "free",
      "healthcheckPath": "/actuator/health",
      "port": 8761
    },
    "gateway": {
      "serviceType": "web", 
      "plan": "free",
      "healthcheckPath": "/actuator/health",
      "port": 8080
    },
    "auth-service": {
      "serviceType": "web",
      "plan": "free", 
      "healthcheckPath": "/actuator/health",
      "port": 8081
    },
    "finance-service": {
      "serviceType": "web",
      "plan": "free",
      "healthcheckPath": "/actuator/health", 
      "port": 8083
    }
  }
}
