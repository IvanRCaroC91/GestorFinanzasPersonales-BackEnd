# Variables de entorno para Railway

# Perfil de Spring
SPRING_PROFILES_ACTIVE=docker

# Base de datos (Railway PostgreSQL)
DATABASE_URL=${RAILWAY_DATABASE_URL}
DATABASE_USER=${RAILWAY_DATABASE_USER}
DATABASE_PASSWORD=${RAILWAY_DATABASE_PASSWORD}
POSTGRES_DB=${RAILWAY_DATABASE_NAME}

# JWT
JWT_SECRET=${JWT_SECRET:mySecretKey123456789012345678901234567890}
JWT_EXPIRATION=86400000

# Eureka (comunicación interna Railway)
EUREKA_URL=http://gestorfinanzaspersonales-backend:8761/eureka/

# Frontend URL (tu Vercel real)
FRONTEND_URL=https://gestor-finanzas-personales-front-1nste8xft.vercel.app

# Puertos
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
FINANCE_SERVICE_PORT=8083

# Dominio público de Railway
RAILWAY_PUBLIC_DOMAIN=api-gateway-production-f3ef.up.railway.app
